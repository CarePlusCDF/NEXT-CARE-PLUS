# Supabase > Connect > Session pooler (IPv4), backend only.
# URL-encode special characters in the password. Prefer verify-full + downloaded CA.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ORIGINS=https://YOUR-SITE.vercel.app,http://localhost:5173
DEMO_STEPS=20
DEMO_WATER_ML=440
DEMO_MANUAL=1
DAILY_STEPS=5000
DAILY_WATER_ML=3000
DAILY_MANUAL=1
CUP_WATER_ML=220
